{
  "name": "openanime",
  "productName": "OpenAnime",
  "version": "2.1.1",
  "type": "module",
  "description": "Desktop Application for OpenAnime",
  "main": "src/main.js",
  "scripts": {
    "start": "pnpm build && tsx node_modules/@electron-forge/cli/src/electron-forge-start",
    "package": "pnpm build && tsx node_modules/@electron-forge/cli/src/electron-forge-package",
    "make": "pnpm build && tsx node_modules/@electron-forge/cli/src/electron-forge-make",
    "publish": "pnpm build && tsx node_modules/@electron-forge/cli/src/electron-forge-publish --verbose",
    "lint": "echo \"No linting configured\"",
    "build": "tsc && node scripts/obfuscate.mjs",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.1",
    "@electron-forge/maker-deb": "^7.8.1",
    "@electron-forge/maker-rpm": "^7.8.1",
    "@electron-forge/maker-squirrel": "^7.8.1",
    "@electron-forge/maker-zip": "^7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.1",
    "@electron-forge/plugin-fuses": "^7.8.1",
    "@electron-forge/publisher-github": "^7.8.1",
    "@electron-forge/shared-types": "^7.8.1",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^24.0.15",
    "electron": "38.0.0-alpha.8",
    "javascript-obfuscator": "^5.5.0",
    "prettier": "^3.6.2",
    "rapidenv": "^1.1.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "keywords": [],
  "author": {
    "name": "Kax675",
    "email": "hi@kax.one"
  },
  "license": "MIT",
  "dependencies": {
    "color": "^5.0.0",
    "electron-context-menu": "^4.1.0",
    "electron-log": "^5.4.1",
    "electron-settings": "^4.0.4",
    "electron-squirrel-startup": "^1.0.1",
    "hex-to-hsl": "^1.0.2",
    "hwid": "^0.5.0"
  },
  "optionalDependencies": {
    "windows-accent-colors": "^1.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "register-scheme",
      "speaker",
      "windows-accent-colors"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
